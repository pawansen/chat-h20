<!DOCTYPE html>
<html>
<head>
	<meta http-equiv="content-language" content="en" />
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Index Page</title>
	<link rel="stylesheet" href="css/font-awesome.min.css" />
	<link href="css/bootstrap.min.css" rel="stylesheet" />
	<link href="css/style.css" rel="stylesheet" />
</head>
<body>
<main class="wrapper2">
	<header class="mainHeader">
		<div class="container-fluid">
			<div class="nav-link">
				<a href="#">www.h20.com</a>
			</div>
		</div>
    </header>
    <section class="section1 mainhowsec">
    		<div class="container">
             <div class="row">
             	<div class="col-md-7 offset-md-1">
             	 <div class="sec howitsec">
             	 		<h2>How to Use?</h2>
             		<ul class="pl-0">
             			<li><span>1. Open www.h20.com website in your device.</span></li><li><span>2. Open <b>Camera</b> & Scan <b>QR Code <i>OR</i></b> Enter Manually</span></li> <li><span>3. Now Enjoy Temporary Chat and File, Doc & Photo Share to Each others!</span></li>
             		</ul>
             	 </div>
             	</div>
             	<div class="col-md-4">
             		<div class="qr-code">
             			<label>Your Id</label>
             			<div class="imgdiv">
							<img src='<%= QrImage %>'>
             			</div>
             			<span>Your ID : <%= QrCode %></span>
             		</div>
             	</div>
             </div>
    	    </div>
    </section>
    <section class="section2">
    	<div class="container">
    		<div class="row">
    			<div class="col-md-3 offset-md-9">
    				<div class="sec2">
    					<label>Remote ID</label>
    					<div class="form-group">
    					<form action="/chat" method="get">
    						<input type="text" name="id" class="form-control" placeholder="Enter Remote ID">
							<input type="submit" class="submit">
    					</form>
    				</div>
    				</div>
    			</div>
    		</div>
    	</div>
    </section>
</main>
		<script type="text/javascript" src="js/jquery.min.js"></script>
		<script type="text/javascript" src="js/bootstrap.min.js"></script>
</body>
</html>
