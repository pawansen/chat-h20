        <script>
			var socket = io.connect('http://localhost:3000');
            //var socket = io.connect('http://159.223.51.198:3000');

            var typing=false;
            var timeout=undefined;
            var user;
            var imgIcon = randomIntFromInterval(1, 15);
            // submit text message without reload/refresh the page
            $('form').submit(function(e){
                e.preventDefault(); // prevents page reloading
                return false;
            });

            /** generate room*/
            function submitRoom() {
                socket.emit('join_room', {fromToken:$('#fromId').val(),toToken:$('#QrId').val()});
                $('#exampleModal').modal('hide');
            }

            socket.on('join_room', function(msg){
                console.log('join_room join_room');
                 //console.log(msg);
            });

            socket.on('roomData', function(data){
                // socket.emit('join_room_sender', data);
              
                 var html = "<li><a href='#' onclick='getMessageRoom("+data.username+")'><div class='d-flex'><div class='chat-user-img online align-self-center me-3 ms-0'><img src="+data.icon+" class='rounded-circle avatar-xs' alt=''><span class='user-status'></span></div><div class='flex-grow-1 overflow-hidden'><h5 class='text-truncate font-size-15 mb-1'>"+data.username+"</h5><input type='hidden' name='sentId' id="+data.username+" class='form-control' value="+data.id+"><p class='chat-user-message text-truncate mb-0'>Hey! there I'm available</p></div></div></a></li>"
                 document.getElementById("userList").innerHTML += html
                 //$("userList").append(html);
            });

            function getMessageRoom(username){
                socket.emit('getMessageUser', {id:$('#'+username).val(),toId:$('#localId').val()});
            }

            function getTyping(){
                socket.emit('typing', {id:$('#sentId').val()});
            }

            socket.on('typing', function(data){
                if(data.type==true)
                $('#typing').text(`Typing...`)
                else
                $('#typing').text("")

                // if(data.type == "typing"){
                //     document.getElementById("typing").innerHTML = "Typing..."
                // }else{
                //     document.getElementById("typing").innerHTML = ""
                // }
                
            });

            socket.on('getMessageUser', function(data){
                console.log('getMessageUser getMessageUser');
                 console.log(data);
                var htm="<div class='me-3'><img src="+data.icon+" class='rounded-circle avatar-xs' alt='chatvia'></div><div class='mes'><h5 class='mb-0'>"+data.username+"</h5><span id='typing'></span></div>";
                document.getElementById("messageUser").innerHTML = htm
            });

            socket.on('joined', function(msg){
               // console.log('joined joined joined');
                // console.log(msg);
            });

             /** generate qr code*/
            socket.emit('qr_code', {icon:"icon/"+imgIcon+".png"}); 
            socket.on("qr_code",function(qrCode){
                console.log(qrCode)
                $('#qrCodeImage').html("<img src="+qrCode.response.QrImage+"></>");
                $('#qrCode').text(qrCode.response.QrCode);
                $('#fromId').val(qrCode.response.QrCode);
                $('#localId').val(qrCode.response.id);
                $('#autogentImage').html("<img src="+qrCode.response.icon+"></>");
            })

            /** generate random image*/
            function randomIntFromInterval(min, max) { // min and max included 
                return Math.floor(Math.random() * (max - min + 1) + min)
            }
            


                                                                                             
    </script>
